principal = []
pares = []
impares = []

for i in range(10):
    val = int(input(f"Digite o {i+1}º número: "))
    principal.append(val)
    if val % 2 == 0:
        pares.append(val)
    else:
        impares.append(val)

print(f"\nLista Principal: {principal}")
print(f"Lista de Pares: {pares}")
print(f"Lista de Ímpares: {impares}")