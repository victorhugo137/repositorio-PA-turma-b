notas = []
for i in range(5):
    nota = float(input(f"Digite a nota do {i+1}º aluno: "))
    notas.append(nota)

media_geral = sum(notas) / len(notas)
acima_da_media = 0

for nota in notas:
    if nota > media_geral:
        acima_da_media += 1

print(f"Média geral da turma: {media_geral:.2f}")
print(f"Quantidade de alunos acima da média: {acima_da_media}")