maior = None
menor = None

for i in range(1, 6):
    valor = int(input(f"Digite o {i}º número: "))
    if i == 1:
        maior = valor
        menor = valor
    else:
        if valor > maior:
            maior = valor
        if valor < menor:
            menor = valor

print(f"\nO MAIOR valor digitado foi: {maior}")
print(f"O MENOR valor digitado foi: {menor}")